{
  "name": "chatmode-in-paseo",
  "version": "0.1.0-alpha.4.37",
  "description": "Direct ChatGPT browser provider for Paseo; no CoS desktop app",
  "private": true,
  "license": "MIT",
  "author": "Pennnnnnnnnn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Project10214/chatmode-in-paseo.git"
  },
  "bugs": {
    "url": "https://github.com/Project10214/chatmode-in-paseo/issues"
  },
  "homepage": "https://github.com/Project10214/chatmode-in-paseo#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "chatgpt",
    "chrome-extension",
    "mv3"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:host-gate": "node --test tests/host-observation-current.mjs",
    "test:host-recovery": "node --test tests/host-observation-current.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node server/standalone.mjs",
    "test:attachment-order": "python3 tests/attachment-order-browser.py",
    "test:failed-send-disposal": "python3 tests/failed-send-disposal-browser.py",
    "test:failed-send-persistence": "python3 tests/failed-send-persistence-browser.py",
    "test:composer-diagnostics": "python3 tests/composer-diagnostics-browser.py",
    "test:sdk": "node --test tests/sdk-contract.mjs",
    "test:receipt-interaction": "python3 tests/receipt-interaction-browser.py",
    "test:catalog": "python3 tests/catalog-browser-regression.py",
    "test:discovery": "python3 tests/discovery-browser.py",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "install:native-wake": "node scripts/install-native-wake.mjs",
    "legacy:dom": "python3 tests/legacy/dom-audit.py",
    "legacy:browser": "python3 tests/legacy/browser-fixture.py",
    "legacy:flow": "python3 tests/legacy/browser-provider-flow.py",
    "legacy:mv3": "python3 tests/legacy/binding-mv3-flow.py",
    "legacy:binding": "python3 tests/legacy/binding-identity-browser.py",
    "legacy:receipt": "python3 tests/legacy/receipt-shell-browser.py",
    "legacy:native": "python3 tests/legacy/native-transplant.py",
    "legacy:apps": "python3 tests/legacy/apps-headless.py",
    "test:mv3-current": "python3 tests/binding-mv3-current.py"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.12.0-beta.2",
    "@getpaseo/client": "0.12.0-beta.2",
    "@getpaseo/protocol": "0.12.0-beta.2",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
